<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Estates Portfolio</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav>
            <a asp-controller="Home" asp-action="Index">Portfolio</a>
            <a asp-controller="Properties" asp-action="Index">Properties</a>
            <a asp-controller="Leases" asp-action="Index">Leases</a>
            <a asp-controller="Tenants" asp-action="Index">Tenants</a>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <footer>
        <p>&copy; @DateTime.Now.Year Estates Portfolio</p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
