<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Scholarship Awards</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav>
            <a asp-controller="Home" asp-action="Index">Overview</a>
            <a asp-controller="Programmes" asp-action="Index">Programmes</a>
            <a asp-controller="Applications" asp-action="Index">Applications</a>
            <a asp-controller="Applicants" asp-action="Index">Applicants</a>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <footer><p>&copy; @DateTime.Now.Year Scholarship Awards</p></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
