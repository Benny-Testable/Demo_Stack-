@model Awards.Web.Models.Programme
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>
<p>@Model.Code &mdash; @Model.Category</p>
<p>@Model.PlacesAvailable places at @Model.AwardAmount.ToString("N2") each</p>

<h2>Applications</h2>
<table>
    <thead><tr><th>Reference</th><th>Applicant</th><th>Score</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var application in Model.Applications)
    {
        <tr>
            <td><a asp-controller="Applications" asp-action="Details" asp-route-id="@application.Id">@application.Reference</a></td>
            <td>@application.Applicant?.FullName</td>
            <td>@application.EligibilityScore.ToString("N2")</td>
            <td>@application.Status</td>
        </tr>
    }
    </tbody>
</table>
